    makePart({ Name="Bench_Back", Size=Vector3.new(6,1.5,0.5),CFrame=CFrame.new(cx, 2.5, cz-0.8), BrickColor=BrickColor.new("Reddish brown"), Material=Enum.Material.Wood, parent=parkFolder })
