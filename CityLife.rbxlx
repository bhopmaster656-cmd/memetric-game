-- Fountain
makePart({ Name="FountainBase", Size=Vector3.new(12,2,12), CFrame=CFrame.new(300, 1, 200), BrickColor=BrickColor.new("Light stone grey"), Material=Enum.Material.Marble,    Shape=Enum.PartType.Cylinder, parent=parkFolder })
