<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>

	<!-- ═══════════════════════════════════════════════════════ WORKSPACE -->
	<Item class="Workspace" referent="RBX001">
		<Properties>
			<string name="Name">Workspace</string>
			<float name="Gravity">196.2</float>
			<bool name="FilteringEnabled">true</bool>
			<bool name="StreamingEnabled">false</bool>
		</Properties>
		<Item class="SpawnLocation" referent="RBX002">
			<Properties>
				<string name="Name">SpawnLocation</string>
				<bool name="Anchored">true</bool>
				<bool name="Neutral">true</bool>
				<int name="Duration">0</int>
				<CoordinateFrame name="CFrame">
					<X>30</X><Y>5</Y><Z>30</Z>
					<R00>1</R00><R01>0</R01><R02>0</R02>
					<R10>0</R10><R11>1</R11><R12>0</R12>
					<R20>0</R20><R21>0</R21><R22>1</R22>
				</CoordinateFrame>
				<Vector3 name="Size"><X>6</X><Y>1</Y><Z>6</Z></Vector3>
				<Color3 name="Color"><R>0</R><G>1</G><B>0.4</B></Color3>
				<!-- 272 = Enum.Material.SmoothPlastic -->
				<token name="Material">272</token>
				<!-- 0 = Enum.SurfaceType.Smooth -->
				<token name="TopSurface">0</token>
				<token name="BottomSurface">0</token>
			</Properties>
		</Item>
	</Item>

	<!-- ═══════════════════════════════════════════════════════ LIGHTING -->
	<Item class="Lighting" referent="RBX010">
		<Properties>
			<string name="Name">Lighting</string>
			<float name="Brightness">2</float>
			<Color3 name="Ambient"><R>0.1</R><G>0.05</G><B>0.2</B></Color3>
			<Color3 name="OutdoorAmbient"><R>0.05</R><G>0.02</G><B>0.1</B></Color3>
			<Color3 name="FogColor"><R>0.05</R><G>0</G><B>0.15</B></Color3>
			<float name="FogEnd">220</float>
			<float name="FogStart">80</float>
			<string name="TimeOfDay">00:00:00</string>
			<float name="GeographicLatitude">0</float>
		</Properties>
		<Item class="BloomEffect" referent="RBX011">
			<Properties>
				<string name="Name">BloomEffect</string>
				<bool name="Enabled">true</bool>
				<float name="Intensity">1.5</float>
				<float name="Size">24</float>
				<float name="Threshold">0.95</float>
			</Properties>
		</Item>
		<Item class="ColorCorrectionEffect" referent="RBX012">
			<Properties>
				<string name="Name">ColorCorrection</string>
				<bool name="Enabled">true</bool>
				<float name="Brightness">-0.05</float>
				<float name="Contrast">0.1</float>
				<float name="Saturation">0.3</float>
				<Color3 name="TintColor"><R>0.9</R><G>0.8</G><B>1</B></Color3>
			</Properties>
		</Item>
	</Item>

	<!-- ══════════════════════════════════════════════ REPLICATED STORAGE -->
	<Item class="ReplicatedStorage" referent="RBX020">
		<Properties><string name="Name">ReplicatedStorage</string></Properties>

		<!-- Modules -->
		<Item class="Folder" referent="RBX021">
			<Properties><string name="Name">Modules</string></Properties>

			<!-- GameConfig -->
			<Item class="ModuleScript" referent="RBX022">
				<Properties>
					<string name="Name">GameConfig</string>
					<ProtectedString name="Source"><![CDATA[
-- GameConfig: Central configuration for NEON WARDROBE
local GameConfig = {
	FLOOR_REQUIREMENTS = { [1]=0, [2]=100, [3]=500 },
	FLOOR_NAMES        = { [1]="Main Club", [2]="VIP Zone", [3]="Celebrity Floor" },
	-- Teleport destinations (above each floor's surface)
	FLOOR_POSITIONS    = {
		[1] = Vector3.new(30, 8, 30),
		[2] = Vector3.new(0,  40, 0),
		[3] = Vector3.new(0,  72, 0),
	},

	BATTLE_DURATION          = 15,
	BATTLE_COOLDOWN          = 30,
	BATTLE_CHALLENGE_RANGE   = 25,

	BATTLE_THEMES = {
		"Cosmic Rave",
		"Morning After Party",
		"90s Villain",
		"Neon Dreams",
		"Street Fashion Week",
		"Cyber Kawaii",
		"Underground Club",
		"Retro Futurism",
		"Robot Dance Off",
		"Galactic Glam",
	},

	BATTLE_WIN_REPUTATION    = 25,
	BATTLE_LOSE_REPUTATION   = 5,
	AUDIENCE_VOTE_REPUTATION = 3,
	STARTING_CURRENCY        = 100,
	BATTLE_WIN_CURRENCY      = 50,
	BATTLE_LOSE_CURRENCY     = 10,

	MOODS = { "Angry", "Happy", "Mysterious", "Cool", "Cute", "Fierce" },

	MOOD_COLORS = {
		Angry      = Color3.fromRGB(255, 50,  50),
		Happy      = Color3.fromRGB(255, 220, 50),
		Mysterious = Color3.fromRGB(150, 0,   255),
		Cool       = Color3.fromRGB(0,   200, 255),
		Cute       = Color3.fromRGB(255, 150, 200),
		Fierce     = Color3.fromRGB(255, 100, 0),
	},

	MOOD_EMOJIS = {
		Angry      = "😠",
		Happy      = "😄",
		Mysterious = "🔮",
		Cool       = "😎",
		Cute       = "🌸",
		Fierce     = "🔥",
	},
}

return GameConfig
]]></ProtectedString>
				</Properties>
			</Item>

			<!-- MoodData -->
			<Item class="ModuleScript" referent="RBX023">
				<Properties>
					<string name="Name">MoodData</string>
					<ProtectedString name="Source"><![CDATA[
-- MoodData: Outfit items and mood definitions
local MoodData = {
	ITEMS = {
		{ Name="Neon Jacket",    Mood="Cool",       Price=50,  Floor=1 },
		{ Name="Cyber Helmet",   Mood="Mysterious", Price=80,  Floor=1 },
		{ Name="Kawaii Dress",   Mood="Cute",       Price=60,  Floor=1 },
		{ Name="Battle Boots",   Mood="Fierce",     Price=70,  Floor=1 },
		{ Name="Grunge Tee",     Mood="Angry",      Price=40,  Floor=1 },
		{ Name="Party Hat",      Mood="Happy",      Price=30,  Floor=1 },
		{ Name="Hologram Wings", Mood="Mysterious", Price=150, Floor=2 },
		{ Name="Neon Sneakers",  Mood="Cool",       Price=90,  Floor=2 },
		{ Name="Fire Gauntlets", Mood="Fierce",     Price=120, Floor=2 },
		{ Name="Rainbow Crown",  Mood="Happy",      Price=200, Floor=3 },
		{ Name="Shadow Cloak",   Mood="Angry",      Price=110, Floor=2 },
		{ Name="Cloud Sneakers", Mood="Cute",       Price=85,  Floor=2 },
	},

	-- Zone unlocks based on combined mood pair
	ZONE_ACCESS = {
		["Cool+Mysterious"]    = "VIP Lounge",
		["Fierce+Angry"]       = "Battle Arena",
		["Cute+Happy"]         = "Kawaii Corner",
		["Cool+Fierce"]        = "Celebrity Spot",
		["Happy+Cute"]         = "Kawaii Corner",
		["Mysterious+Cool"]    = "VIP Lounge",
	},
}

return MoodData
]]></ProtectedString>
				</Properties>
