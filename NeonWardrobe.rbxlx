	<!-- ══════════════════════════════════════════ SERVER SCRIPT SERVICE -->
	<Item class="ServerScriptService" referent="RBX040">
		<Properties><string name="Name">ServerScriptService</string></Properties>

		<!-- WorldBuilder -->
		<Item class="Script" referent="RBX041">
			<Properties>
				<string name="Name">WorldBuilder</string>
				<bool name="Disabled">false</bool>
				<ProtectedString name="Source"><![CDATA[
-- WorldBuilder: Procedurally constructs the NEON WARDROBE three-floor building.
-- Runs once on the server at game start.

local Workspace = game:GetService("Workspace")

local PINK   = Color3.fromRGB(255, 0,   150)
local CYAN   = Color3.fromRGB(0,   200, 255)
local PURPLE = Color3.fromRGB(150, 0,   255)
local GOLD   = Color3.fromRGB(255, 200, 50)
local DARK   = Color3.fromRGB(15,  10,  30)
local DFLOOR = Color3.fromRGB(12,  12,  25)
local DPURP  = Color3.fromRGB(20,  10,  40)
local DBLUE  = Color3.fromRGB(10,  20,  50)
local DGOLD  = Color3.fromRGB(35,  25,  5)
local EGRAY  = Color3.fromRGB(60,  60,  80)

-- ---------- helpers ----------

local function p(parent, name, size, pos, col, mat, anchored)
	local part = Instance.new("Part")
	part.Name         = name
	part.Size         = size
	part.CFrame       = CFrame.new(pos)
	part.Color        = col
	part.Material     = mat or Enum.Material.SmoothPlastic
	part.Anchored     = (anchored ~= false)
	part.TopSurface   = Enum.SurfaceType.Smooth
	part.BottomSurface= Enum.SurfaceType.Smooth
	part.Parent       = parent
	return part
end

local function light(part, col, bright, range)
	local l = Instance.new("PointLight")
	l.Color      = col
	l.Brightness = bright or 2
	l.Range      = range  or 20
	l.Parent     = part
end

local function sign(part, text, col, face)
	local sg  = Instance.new("SurfaceGui")
	sg.Face             = face or Enum.NormalId.Front
	sg.SizingMode       = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud    = 20
	sg.Parent           = part
	local lbl = Instance.new("TextLabel")
	lbl.Size                 = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.Text                 = text
	lbl.TextColor3           = col or Color3.new(1,1,1)
	lbl.TextScaled           = true
	lbl.Font                 = Enum.Font.GothamBold
	lbl.Parent               = sg
end

-- ---------- building root ----------

local bld = Instance.new("Model")
bld.Name   = "NeonWardrobe"
bld.Parent = Workspace

-- ════════════ FLOOR 1 — Main Club (Y 0-31) ════════════
local f1 = Instance.new("Model")
f1.Name   = "Floor1_MainClub"
f1.Parent = bld

p(f1,"Floor",   Vector3.new(100,2,100), Vector3.new( 0,  1,  0), DFLOOR)
p(f1,"Ceiling", Vector3.new(100,2,100), Vector3.new( 0, 30,  0), DPURP)
p(f1,"WallN",   Vector3.new(100,29,2),  Vector3.new( 0, 16,-51), DPURP)
p(f1,"WallS",   Vector3.new(100,29,2),  Vector3.new( 0, 16, 51), DPURP)
p(f1,"WallE",   Vector3.new(2, 29,100), Vector3.new(51, 16,  0), DPURP)
p(f1,"WallW",   Vector3.new(2, 29,100), Vector3.new(-51,16,  0), DPURP)

-- entrance gap: two side pillars + top beam instead of full south wall
p(f1,"DoorL",   Vector3.new(30,29,2), Vector3.new(-30,16, 51), DPURP)
p(f1,"DoorR",   Vector3.new(30,29,2), Vector3.new( 30,16, 51), DPURP)
p(f1,"DoorTop", Vector3.new(40,10,2), Vector3.new(  0,26, 51), DPURP)

-- main neon sign on north wall
local ms = p(f1,"MainSign",Vector3.new(42,6,1),Vector3.new(0,24,-50),PINK,Enum.Material.Neon)
light(ms, PINK, 3, 30)
sign(ms, "* NEON WARDROBE *", PINK)

-- neon floor strips (cyan lines running front-to-back)
for i = -4, 4 do
	local s = p(f1,"Strip"..i, Vector3.new(90,0.2,0.4), Vector3.new(0,2.12,i*10), CYAN, Enum.Material.Neon)
	light(s, CYAN, 0.7, 6)
end

-- battle arena (centre glowing pad)
local arena = p(f1,"BattleArena", Vector3.new(22,0.3,22), Vector3.new(0,2.2,0), PURPLE, Enum.Material.Neon)
light(arena, PURPLE, 2, 26)
local aS = p(f1,"ArenaSign", Vector3.new(18,3,1), Vector3.new(0,10,-12), Color3.fromRGB(255,50,150), Enum.Material.Neon)
light(aS, Color3.fromRGB(255,50,150), 2, 15)
sign(aS, "BATTLE ZONE", Color3.fromRGB(255,50,150))

-- shop zone (left, orange)
local shopFloor = p(f1,"ShopFloor", Vector3.new(25,0.3,40), Vector3.new(-35,2.2,0), Color3.fromRGB(255,150,0), Enum.Material.Neon)
light(shopFloor, Color3.fromRGB(255,150,0), 1, 15)
local shopS = p(f1,"ShopSign", Vector3.new(20,3,1), Vector3.new(-35,13,-21), Color3.fromRGB(255,150,0), Enum.Material.Neon)
light(shopS, Color3.fromRGB(255,150,0), 2, 15)
sign(shopS, "STYLE SHOP", Color3.fromRGB(255,150,0))

-- spawn pad (right back — matches SpawnLocation)
local spPad = p(f1,"SpawnPad", Vector3.new(10,0.3,10), Vector3.new(30,2.2,30), Color3.fromRGB(0,255,100), Enum.Material.Neon)
light(spPad, Color3.fromRGB(0,255,100), 1, 10)

-- ════════════ FLOOR 2 — VIP Zone (Y 32-63) ════════════
local f2 = Instance.new("Model")
f2.Name   = "Floor2_VIPZone"
f2.Parent = bld

p(f2,"Floor",   Vector3.new(80,2,80), Vector3.new( 0,33,  0), DFLOOR)
p(f2,"Ceiling", Vector3.new(80,2,80), Vector3.new( 0,62,  0), DBLUE)
p(f2,"WallN",   Vector3.new(80,27,2), Vector3.new( 0,48,-41), DBLUE)
p(f2,"WallS",   Vector3.new(80,27,2), Vector3.new( 0,48, 41), DBLUE)
p(f2,"WallE",   Vector3.new(2,27,80), Vector3.new(41,48,  0), DBLUE)
p(f2,"WallW",   Vector3.new(2,27,80), Vector3.new(-41,48, 0), DBLUE)

local vipS = p(f2,"VIPSign", Vector3.new(30,5,1), Vector3.new(0,57,-40), CYAN, Enum.Material.Neon)
light(vipS, CYAN, 3, 30)
sign(vipS, "VIP EXCLUSIVE", CYAN)

-- checkerboard floor tiles
for i = -3, 3 do
	for j = -3, 3 do
		if (i+j) % 2 == 0 then
			local t = p(f2,"Tile"..i.."_"..j, Vector3.new(10,0.2,10), Vector3.new(i*10,35.1,j*10), CYAN, Enum.Material.Neon)
			t.Transparency = 0.75
		end
	end
end

local lounge = p(f2,"LoungeArea", Vector3.new(30,0.3,20), Vector3.new(-20,35.2,0), PURPLE, Enum.Material.Neon)
light(lounge, PURPLE, 1, 15)

local vipShop = p(f2,"VIPShop",     Vector3.new(20,0.3,30), Vector3.new(25,35.2,0), Color3.fromRGB(0,100,255), Enum.Material.Neon)
local vipShopS = p(f2,"VIPShopSign",Vector3.new(18,3,1),    Vector3.new(25,45,-16), Color3.fromRGB(0,100,255), Enum.Material.Neon)
sign(vipShopS, "VIP BOUTIQUE", Color3.fromRGB(0,100,255))

-- ════════════ FLOOR 3 — Celebrity Zone (Y 64-93) ════════════
local f3 = Instance.new("Model")
f3.Name   = "Floor3_Celebrity"
f3.Parent = bld

p(f3,"Floor",   Vector3.new(50,2,50), Vector3.new( 0,65,  0), DFLOOR)
p(f3,"Ceiling", Vector3.new(50,2,50), Vector3.new( 0,92,  0), DGOLD)
p(f3,"WallN",   Vector3.new(50,25,2), Vector3.new( 0,79,-26), DGOLD)
p(f3,"WallS",   Vector3.new(50,25,2), Vector3.new( 0,79, 26), DGOLD)
p(f3,"WallE",   Vector3.new(2,25,50), Vector3.new(26,79,  0), DGOLD)
p(f3,"WallW",   Vector3.new(2,25,50), Vector3.new(-26,79, 0), DGOLD)

local cS = p(f3,"CelebSign", Vector3.new(35,6,1), Vector3.new(0,84,-25), GOLD, Enum.Material.Neon)
light(cS, GOLD, 4, 35)
sign(cS, "CELEBRITY FLOOR", GOLD)

for i = -2, 2 do
	local star = p(f3,"GoldStar"..i, Vector3.new(7,0.3,7), Vector3.new(i*10,67.1,0), GOLD, Enum.Material.Neon)
	light(star, GOLD, 1.5, 10)
end

local trophy = p(f3,"TrophyBase", Vector3.new(10,0.5,10), Vector3.new(0,67.2,-15), GOLD, Enum.Material.Neon)
light(trophy, GOLD, 2, 15)
local tS = p(f3,"TrophySign", Vector3.new(10,3,1), Vector3.new(0,75,-21), GOLD, Enum.Material.Neon)
sign(tS, "HALL OF FAME", GOLD)

-- ════════════ ELEVATOR ════════════
local elev = Instance.new("Model")
elev.Name   = "Elevator"
elev.Parent = bld

-- shaft (open on west side so players can see cab)
p(elev,"ShaftN", Vector3.new(10,95,2),  Vector3.new(40,50,-5),  Color3.fromRGB(40,40,60))
p(elev,"ShaftS", Vector3.new(10,95,2),  Vector3.new(40,50, 5),  Color3.fromRGB(40,40,60))
p(elev,"ShaftE", Vector3.new(2, 95,10), Vector3.new(45,50, 0),  Color3.fromRGB(40,40,60))

-- elevator cabin (starts on floor 1)
local cab = p(elev,"ElevatorCab", Vector3.new(8,8,8), Vector3.new(40,6,0), EGRAY)
cab.Anchored = true
light(cab, CYAN, 2, 15)

-- call-button panels (ProximityPrompt on each floor)
local function elevBtn(yPos, floorNum)
	local btn = p(elev,"ElevBtn_F"..floorNum, Vector3.new(1,2,0.5), Vector3.new(36,yPos,0), Color3.fromRGB(30,30,60))
	sign(btn, "LIFT\nF"..floorNum, CYAN)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText           = "Use Elevator"
	pp.ObjectText           = "Floor "..floorNum.." Lift"
	pp.HoldDuration         = 0
	pp.MaxActivationDistance= 8
	pp.KeyboardKeyCode      = Enum.KeyCode.E
	pp.Parent               = btn
	return btn
end
elevBtn(16, 1)
elevBtn(47, 2)
elevBtn(79, 3)

-- ════════════ EXTERIOR ════════════
local ext = Instance.new("Model")
ext.Name   = "Exterior"
ext.Parent = bld

p(ext,"FacadeN",  Vector3.new(104,95,4),  Vector3.new(  0,50,-54), DARK)
p(ext,"FacadeE",  Vector3.new(4, 95,104), Vector3.new( 54,50,  0), DARK)
p(ext,"FacadeW",  Vector3.new(4, 95,104), Vector3.new(-54,50,  0), DARK)
p(ext,"Roof",     Vector3.new(112,4,112), Vector3.new(  0,98,  0), Color3.fromRGB(10,5,20))

-- exterior neon signage
local exS1 = p(ext,"ExtSign1", Vector3.new(60,8,1), Vector3.new(0,80,-53), PINK, Enum.Material.Neon)
light(exS1, PINK, 5, 40)
sign(exS1, "** NEON WARDROBE **", PINK)

local exS2 = p(ext,"ExtSign2", Vector3.new(35,4,1), Vector3.new(0,65,-53), CYAN, Enum.Material.Neon)
light(exS2, CYAN, 3, 25)
sign(exS2, "OPEN 24/7", CYAN)

-- entrance door frame
p(ext,"EntL",   Vector3.new(30,18,4), Vector3.new(-30,10,-54), DARK)
p(ext,"EntR",   Vector3.new(30,18,4), Vector3.new( 30,10,-54), DARK)
p(ext,"EntTop", Vector3.new(40,8, 4), Vector3.new(  0,23,-54), DARK)
local entTrim = p(ext,"EntTrim", Vector3.new(40,2,4), Vector3.new(0,18,-54), PURPLE, Enum.Material.Neon)
light(entTrim, PURPLE, 3, 20)

-- ground plane and neon roads
p(ext,"Ground", Vector3.new(300,2,300), Vector3.new(0,-1,100), Color3.fromRGB(10,8,20))
for i = -3, 3 do
	local road = p(ext,"Road"..i, Vector3.new(3,0.1,200), Vector3.new(i*20,0.05,150), CYAN, Enum.Material.Neon)
	road.Transparency = 0.8
end

print("[WorldBuilder] NEON WARDROBE built successfully!")
print("[WorldBuilder] Floor 1: Main Club      Y=2..31  (100x100)")
print("[WorldBuilder] Floor 2: VIP Zone       Y=33..63 (80x80)")
print("[WorldBuilder] Floor 3: Celebrity Floor Y=65..93 (50x50)")
]]></ProtectedString>
			</Properties>
		</Item><!-- /WorldBuilder -->

		<!-- GameManager -->
		<Item class="Script" referent="RBX042">
			<Properties>
				<string name="Name">GameManager</string>
				<bool name="Disabled">false</bool>
				<ProtectedString name="Source"><![CDATA[
-- GameManager: Player data, leaderstats, currency and reputation.
-- Exposes _G.GameManager for other server scripts.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig        = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameConfig"))
local remotes           = ReplicatedStorage:WaitForChild("RemoteEvents")

local playerData = {}   -- [userId] -> { reputation, currency, currentFloor, mood, ... }

-- ── init/cleanup ──────────────────────────────────────────────────

local function initPlayer(player)
	playerData[player.UserId] = {
		reputation   = 0,
		currency     = GameConfig.STARTING_CURRENCY,
		currentFloor = 1,
		mood         = "Cool",
		battlesWon   = 0,
		battlesLost  = 0,
	}

	-- Leaderstats (visible in player list)
	local ls = Instance.new("Folder")
	ls.Name   = "leaderstats"
	ls.Parent = player

	local repVal = Instance.new("IntValue")
	repVal.Name   = "Reputation"
	repVal.Value  = 0
	repVal.Parent = ls

	local coinVal = Instance.new("IntValue")
	coinVal.Name   = "NeonCoins"
	coinVal.Value  = GameConfig.STARTING_CURRENCY
	coinVal.Parent = ls

	local floorVal = Instance.new("IntValue")
	floorVal.Name   = "Floor"
	floorVal.Value  = 1
	floorVal.Parent = ls

	remotes.UpdateCurrency:FireClient(player, GameConfig.STARTING_CURRENCY)
	print("[GameManager] Initialised: " .. player.Name)
end

local function cleanPlayer(player)
	playerData[player.UserId] = nil
end

-- ── public API ────────────────────────────────────────────────────

local function getData(player)
	return playerData[player.UserId]
end

local function addReputation(player, amount)
	local d = getData(player)
	if not d then return end
	d.reputation = d.reputation + amount
	local ls = player:FindFirstChild("leaderstats")
	if ls then ls.Reputation.Value = d.reputation end

	-- Floor unlock check
	for floorNum = 2, 3 do
		local req = GameConfig.FLOOR_REQUIREMENTS[floorNum]
		if d.reputation >= req and d.currentFloor < floorNum then
			d.currentFloor = floorNum
			if ls then ls.Floor.Value = floorNum end
			remotes.UnlockFloor:FireClient(player, {
				floorUnlocked = floorNum,
				floorName     = GameConfig.FLOOR_NAMES[floorNum],
			})
			print("[GameManager] " .. player.Name .. " unlocked Floor " .. floorNum)
		end
	end
end

local function addCurrency(player, amount)
	local d = getData(player)
	if not d then return end
	d.currency = d.currency + amount
	local ls = player:FindFirstChild("leaderstats")
	if ls then ls.NeonCoins.Value = d.currency end
	remotes.UpdateCurrency:FireClient(player, d.currency)
end

-- Handle mood update from client
remotes.UpdateMood.OnServerEvent:Connect(function(player, mood)
	local d = getData(player)
	if d then d.mood = mood end
end)

-- ── hooks ─────────────────────────────────────────────────────────
Players.PlayerAdded:Connect(initPlayer)
Players.PlayerRemoving:Connect(cleanPlayer)
for _, p in ipairs(Players:GetPlayers()) do initPlayer(p) end

-- Expose global API for BattleSystem / ProgressionSystem
_G.GameManager = {
	getData       = getData,
	addReputation = addReputation,
	addCurrency   = addCurrency,
}

print("[GameManager] Initialised!")
]]></ProtectedString>
			</Properties>
		</Item><!-- /GameManager -->

		<!-- BattleSystem -->
		<Item class="Script" referent="RBX043">
			<Properties>
				<string name="Name">BattleSystem</string>
				<bool name="Disabled">false</bool>
				<ProtectedString name="Source"><![CDATA[
-- BattleSystem: 15-second Look Battle mini-game.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig        = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameConfig"))
local remotes           = ReplicatedStorage:WaitForChild("RemoteEvents")

-- Wait until GameManager is ready
repeat task.wait(0.1) until _G.GameManager

local activeBattles = {}
local cooldowns     = {}

-- ── helpers ───────────────────────────────────────────────────────

local function pickTheme()
	return GameConfig.BATTLE_THEMES[math.random(#GameConfig.BATTLE_THEMES)]
end

local function valid(player)
	return player and player.Parent ~= nil
end

-- ── start battle ──────────────────────────────────────────────────

local function startBattle(challenger, opponent)
	local now = tick()
	-- Cooldown guard
	if cooldowns[challenger.UserId] and now < cooldowns[challenger.UserId] then
		remotes.StartBattle:FireClient(challenger, { error = "You are on cooldown! Please wait." })
		return
	end
	if cooldowns[opponent.UserId] and now < cooldowns[opponent.UserId] then
		remotes.StartBattle:FireClient(challenger, { error = opponent.Name .. " is on cooldown." })
		return
	end

	local battleId = tostring(challenger.UserId) .. "_" .. tostring(now)
	local theme    = pickTheme()

	activeBattles[battleId] = {
		challenger      = challenger,
		opponent        = opponent,
		theme           = theme,
		challengerVotes = 0,
		opponentVotes   = 0,
		voters          = {},
	}

	-- Notify participants
	remotes.StartBattle:FireClient(challenger, {
		battleId       = battleId, role = "challenger",
		theme          = theme,    duration = GameConfig.BATTLE_DURATION,
		opponentName   = opponent.Name,
	})
	remotes.StartBattle:FireClient(opponent, {
		battleId       = battleId, role = "opponent",
		theme          = theme,    duration = GameConfig.BATTLE_DURATION,
		challengerName = challenger.Name,
	})

	-- Notify nearby spectators
	local cHRP = challenger.Character and challenger.Character:FindFirstChild("HumanoidRootPart")
	if cHRP then
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl ~= challenger and pl ~= opponent and pl.Character then
				local h = pl.Character:FindFirstChild("HumanoidRootPart")
				if h and (h.Position - cHRP.Position).Magnitude < 60 then
					remotes.StartBattle:FireClient(pl, {
						battleId       = battleId, role = "spectator",
						theme          = theme,    duration = GameConfig.BATTLE_DURATION,
						challengerName = challenger.Name,
						opponentName   = opponent.Name,
					})
				end
			end
		end
	end

	print("[BattleSystem] Battle " .. battleId .. " | Theme: " .. theme)

	-- ── end battle after BATTLE_DURATION ──────────────────────────
	task.delay(GameConfig.BATTLE_DURATION, function()
		local battle = activeBattles[battleId]
		if not battle then return end

		local chal = battle.challenger
		local opp  = battle.opponent
		local chalOK = valid(chal)
		local oppOK  = valid(opp)

		if not chalOK and not oppOK then
			activeBattles[battleId] = nil
			return
		end

		-- Determine winner by vote count (random tie-break)
		local winner, loser
		if chalOK and oppOK then
			if battle.challengerVotes > battle.opponentVotes then
				winner, loser = chal, opp
			elseif battle.opponentVotes > battle.challengerVotes then
				winner, loser = opp, chal
			else
				-- True tie: fair random selection
				if math.random() >= 0.5 then
					winner, loser = chal, opp
				else
					winner, loser = opp, chal
				end
			end
		elseif chalOK then
			winner = chal
		else
			winner = opp
		end

		local GM = _G.GameManager

		if valid(winner) then
			if GM then
				GM.addReputation(winner, GameConfig.BATTLE_WIN_REPUTATION)
				GM.addCurrency(winner,   GameConfig.BATTLE_WIN_CURRENCY)
			end
			remotes.BattleResult:FireClient(winner, {
				result           = "win",
				reputationGained = GameConfig.BATTLE_WIN_REPUTATION,
				currencyGained   = GameConfig.BATTLE_WIN_CURRENCY,
			})
		end

		if loser and valid(loser) then
			if GM then
				GM.addReputation(loser, GameConfig.BATTLE_LOSE_REPUTATION)
				GM.addCurrency(loser,   GameConfig.BATTLE_LOSE_CURRENCY)
			end
			remotes.BattleResult:FireClient(loser, {
				result           = "lose",
				reputationGained = GameConfig.BATTLE_LOSE_REPUTATION,
			})
		end

		-- Cooldowns
		if chalOK then cooldowns[chal.UserId] = tick() + GameConfig.BATTLE_COOLDOWN end
		if oppOK  then cooldowns[opp.UserId]  = tick() + GameConfig.BATTLE_COOLDOWN end

		activeBattles[battleId] = nil
		print("[BattleSystem] Battle ended: " .. battleId
			.. " | Winner: " .. (winner and winner.Name or "none"))
	end)
end

-- ── remote handler ────────────────────────────────────────────────

remotes.StartBattle.OnServerEvent:Connect(function(player, action, data)
	if action == "challenge" and data and data.targetName then
		local target = Players:FindFirstChild(data.targetName)
		if target then
			startBattle(player, target)
		else
			remotes.StartBattle:FireClient(player, { error = "Player not found." })
		end

	elseif action == "vote" and data and data.battleId then
		local battle = activeBattles[data.battleId]
		if not battle or battle.voters[player.UserId] then return end
		-- Participants (challenger / opponent) cannot vote for themselves
		if battle.challenger.UserId == player.UserId
		or battle.opponent.UserId   == player.UserId then return end
		battle.voters[player.UserId] = true
		if data.votedFor == "challenger" then
			battle.challengerVotes = battle.challengerVotes + 1
		else
			battle.opponentVotes = battle.opponentVotes + 1
		end
		local GM = _G.GameManager
		if GM then GM.addReputation(player, GameConfig.AUDIENCE_VOTE_REPUTATION) end
	end
end)

print("[BattleSystem] Initialised!")
]]></ProtectedString>
			</Properties>
		</Item><!-- /BattleSystem -->

		<!-- ProgressionSystem -->
		<Item class="Script" referent="RBX044">
			<Properties>
				<string name="Name">ProgressionSystem</string>
				<bool name="Disabled">false</bool>
				<ProtectedString name="Source"><![CDATA[
-- ProgressionSystem: Elevator usage and floor-access validation.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")
local GameConfig        = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameConfig"))
local remotes           = ReplicatedStorage:WaitForChild("RemoteEvents")

repeat task.wait(0.1) until _G.GameManager

-- ── teleport player to a floor ────────────────────────────────────

local function useElevator(player, targetFloor)
	local d   = _G.GameManager.getData(player)
	if not d then return end

	local req = GameConfig.FLOOR_REQUIREMENTS[targetFloor]
	if not req then return end

	if d.reputation < req then
		remotes.UnlockFloor:FireClient(player, {
			error = string.format(
				"Floor %d needs %d Reputation. You have %d.",
				targetFloor, req, d.reputation)
		})
		return
	end

	local pos = GameConfig.FLOOR_POSITIONS[targetFloor]
	if not pos then return end

	local char = player.Character
	if char then
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.CFrame       = CFrame.new(pos + Vector3.new(0, 3, 0))
			d.currentFloor   = targetFloor
			local ls = player:FindFirstChild("leaderstats")
			if ls then ls.Floor.Value = targetFloor end
			print("[ProgressionSystem] " .. player.Name .. " -> Floor " .. targetFloor)
		end
	end
end

-- ── client sends target floor number ──────────────────────────────

remotes.RequestElevator.OnServerEvent:Connect(function(player, payload)
	if type(payload) == "number" then
		useElevator(player, payload)
	end
end)

-- ── wire up ProximityPrompts created by WorldBuilder ──────────────

task.spawn(function()
	task.wait(3)   -- give WorldBuilder time to finish
	local bld  = Workspace:WaitForChild("NeonWardrobe", 15)
	if not bld then return end
	local elevModel = bld:WaitForChild("Elevator", 10)
	if not elevModel then return end

	for _, obj in ipairs(elevModel:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then
			obj.Triggered:Connect(function(player)
				-- Tell the client to open the elevator panel
				remotes.RequestElevator:FireClient(player, "open")
			end)
		end
	end
	print("[ProgressionSystem] Elevator prompts connected.")
end)

-- ── every 60 s: announce the server's top-reputation player ───────

task.spawn(function()
	while true do
		task.wait(60)
		local all = Players:GetPlayers()
		if #all == 0 then continue end

		local best, bestRep = nil, -1
		for _, pl in ipairs(all) do
			local d = _G.GameManager.getData(pl)
			if d and d.reputation > bestRep then
				bestRep = d.reputation
				best    = pl
			end
		end

		if best and bestRep >= GameConfig.FLOOR_REQUIREMENTS[3] then
			for _, pl in ipairs(all) do
				remotes.StartBattle:FireClient(pl, {
					announcement = best.Name .. " reigns the Celebrity Floor with "
						.. bestRep .. " Rep!",
				})
			end
		end
	end
end)

print("[ProgressionSystem] Initialised!")
]]></ProtectedString>
			</Properties>
		</Item><!-- /ProgressionSystem -->
	</Item><!-- /ServerScriptService -->

	<!-- ════════════════════════════════════════════════ STARTER PLAYER -->
