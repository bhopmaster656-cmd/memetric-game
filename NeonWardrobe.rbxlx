					<string name="Name">MainClient</string>
					<bool name="Disabled">false</bool>
					<ProtectedString name="Source"><![CDATA[
-- MainClient: UI creation, battle client, outfit/mood system, elevator.
-- Single LocalScript to avoid race conditions between multiple scripts.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local TweenService      = game:GetService("TweenService")

local player    = Players.LocalPlayer
local playerGui = player.PlayerGui

-- Modules & remotes
local modules  = ReplicatedStorage:WaitForChild("Modules")
local remotes  = ReplicatedStorage:WaitForChild("RemoteEvents")

local GameConfig = require(modules:WaitForChild("GameConfig"))
require(modules:WaitForChild("MoodData"))   -- preload

local startBattleEv = remotes:WaitForChild("StartBattle")
local battleResultEv= remotes:WaitForChild("BattleResult")
local updateCoinEv  = remotes:WaitForChild("UpdateCurrency")
local unlockFloorEv = remotes:WaitForChild("UnlockFloor")
local requestElevEv = remotes:WaitForChild("RequestElevator")
local updateMoodEv  = remotes:WaitForChild("UpdateMood")

-- ════════════════════════════════ COLOUR PALETTE ═════════════════

local C = {
	bg      = Color3.fromRGB( 10,  5,  25),
	bgDark  = Color3.fromRGB(  5,  0,  15),
	pink    = Color3.fromRGB(255,  0, 150),
	cyan    = Color3.fromRGB(  0,200, 255),
	purple  = Color3.fromRGB(150,  0, 255),
	gold    = Color3.fromRGB(255,200,  50),
	white   = Color3.fromRGB(255,255, 255),
	dim     = Color3.fromRGB(180,180, 220),
	green   = Color3.fromRGB(  0,255, 100),
	red     = Color3.fromRGB(255, 50,  50),
	orange  = Color3.fromRGB(255,150,   0),
}

-- ═══════════════════════════════════ UI HELPERS ══════════════════

local function mkFrame(parent, name, size, pos, bg, alpha)
	local f = Instance.new("Frame")
	f.Name, f.Size, f.Position = name, size, pos
	f.BackgroundColor3       = bg    or C.bg
	f.BackgroundTransparency = alpha or 0
	f.BorderSizePixel        = 0
	f.Parent                 = parent
	return f
end

local function mkLabel(parent, name, text, size, pos, col, fs, font, xAlign)
	local l = Instance.new("TextLabel")
	l.Name, l.Text, l.Size, l.Position = name, text, size, pos
	l.BackgroundTransparency = 1
	l.TextColor3  = col   or C.white
	l.TextSize    = fs    or 16
	l.Font        = font  or Enum.Font.GothamBold
	l.TextXAlignment = xAlign or Enum.TextXAlignment.Center
	l.Parent      = parent
	return l
end

local function mkBtn(parent, name, text, size, pos, bg, col)
	local b = Instance.new("TextButton")
	b.Name, b.Text, b.Size, b.Position = name, text, size, pos
	b.BackgroundColor3 = bg  or C.pink
	b.TextColor3       = col or C.white
	b.TextSize         = 16
	b.Font             = Enum.Font.GothamBold
	b.BorderSizePixel  = 0
	b.AutoButtonColor  = true
	b.Parent           = parent
	return b
end

local function corner(parent, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 8)
	c.Parent = parent
end

local function stroke(parent, col, thick)
	local s = Instance.new("UIStroke")
	s.Color     = col   or C.pink
	s.Thickness = thick or 2
	s.Parent    = parent
end

local function grad(parent, a, b, rot)
	local g = Instance.new("UIGradient")
	g.Color    = ColorSequence.new(a, b)
	g.Rotation = rot or 90
	g.Parent   = parent
end

-- ═══════════════════════════════════ MAIN HUD ════════════════════

local mainHUD = playerGui:WaitForChild("MainHUD")

-- Top bar
local topBar = mkFrame(mainHUD,"TopBar", UDim2.new(1,0,0,52), UDim2.new(0,0,0,0), C.bgDark, 0.25)

-- Reputation pill (top-left)
local repPill = mkFrame(topBar,"RepPill", UDim2.new(0,215,1,-10), UDim2.new(0,5,0,5), Color3.fromRGB(30,0,50), 0)
corner(repPill,6); stroke(repPill, C.purple, 1)
local repLabel = mkLabel(repPill,"RepLabel","Rep: 0", UDim2.new(1,0,1,0), UDim2.new(0,0,0,0), C.purple, 15)

-- Currency pill (top-right)
local coinPill = mkFrame(topBar,"CoinPill", UDim2.new(0,215,1,-10), UDim2.new(1,-220,0,5), Color3.fromRGB(40,30,0), 0)
corner(coinPill,6); stroke(coinPill, C.gold, 1)
local currencyLabel = mkLabel(coinPill,"CurrencyLabel","100 Coins", UDim2.new(1,0,1,0), UDim2.new(0,0,0,0), C.gold, 15)

-- Floor pill (top-centre)
local floorPill = mkFrame(topBar,"FloorPill", UDim2.new(0,240,1,-10), UDim2.new(0.5,-120,0,5), Color3.fromRGB(0,25,40), 0)
corner(floorPill,6); stroke(floorPill, C.cyan, 1)
local floorLabel = mkLabel(floorPill,"FloorLabel","Floor 1 - Main Club", UDim2.new(1,0,1,0), UDim2.new(0,0,0,0), C.cyan, 14)

-- Notification banner
local notifLabel = mkLabel(mainHUD,"NotificationLabel","",
	UDim2.new(0.7,0,0,36), UDim2.new(0.15,0,0,58), C.gold, 18)
notifLabel.TextStrokeTransparency = 0.4
notifLabel.TextStrokeColor3       = Color3.new(0,0,0)

-- Mood pill (bottom-left)
local moodPill = mkFrame(mainHUD,"MoodPill", UDim2.new(0,180,0,46), UDim2.new(0,10,1,-60), Color3.fromRGB(40,0,30), 0)
corner(moodPill,8); stroke(moodPill, C.pink, 1)
local moodLabel = mkLabel(moodPill,"MoodLabel","Mood: Cool", UDim2.new(1,0,1,0), UDim2.new(0,0,0,0), C.pink, 15)

-- Challenge button (bottom-right)
local challengeBtn = mkBtn(mainHUD,"ChallengeBtn","CHALLENGE",
	UDim2.new(0,155,0,48), UDim2.new(1,-165,1,-60), C.pink)
corner(challengeBtn); grad(challengeBtn, C.pink, Color3.fromRGB(200,0,255))

-- Elevator button (right, mid-screen)
local elevatorBtn = mkBtn(mainHUD,"ElevatorBtn","ELEVATOR",
	UDim2.new(0,130,0,42), UDim2.new(1,-142,0.5,-21), Color3.fromRGB(20,20,50))
corner(elevatorBtn); stroke(elevatorBtn, C.cyan, 1); elevatorBtn.TextColor3 = C.cyan

-- Outfit button (bottom-left, above mood)
local outfitBtn = mkBtn(mainHUD,"OutfitBtn","OUTFIT",
	UDim2.new(0,130,0,42), UDim2.new(0,10,1,-115), Color3.fromRGB(20,10,40))
corner(outfitBtn); stroke(outfitBtn, C.purple, 1); outfitBtn.TextColor3 = C.purple

-- ═══════════════════════════════════ BATTLE UI ═══════════════════

local battleUI = playerGui:WaitForChild("BattleUI")

local bFrame = mkFrame(battleUI,"BattleFrame",
	UDim2.new(0,520,0,370), UDim2.new(0.5,-260,0.5,-185), C.bgDark, 0)
bFrame.Visible = false
corner(bFrame,12); stroke(bFrame, C.pink)

-- Title bar
local bTitleBar = mkFrame(bFrame,"TitleBar", UDim2.new(1,0,0,48), UDim2.new(0,0,0,0), Color3.fromRGB(40,0,25), 0)
corner(bTitleBar,12)
mkLabel(bTitleBar,"Title","LOOK BATTLE", UDim2.new(1,0,1,0), UDim2.new(0,0,0,0), C.pink, 26)

-- Timer box
local timerBox = mkFrame(bFrame,"TimerBox", UDim2.new(0,90,0,52), UDim2.new(0.5,-45,0,52), Color3.fromRGB(0,30,50), 0.35)
corner(timerBox,8); stroke(timerBox, C.cyan, 1)
local timerLabel = mkLabel(timerBox,"TimerLabel","15", UDim2.new(1,0,1,0), UDim2.new(0,0,0,0), C.cyan, 34)

-- Theme box
local themeBox = mkFrame(bFrame,"ThemeBox", UDim2.new(0.85,0,0,38), UDim2.new(0.075,0,0,112), Color3.fromRGB(30,20,0), 0.4)
corner(themeBox,6); stroke(themeBox, C.gold, 1)
local themeLabel = mkLabel(themeBox,"ThemeLabel","Theme: ...", UDim2.new(1,0,1,0), UDim2.new(0,0,0,0), C.gold, 18)

-- Status
local statusLabel = mkLabel(bFrame,"StatusLabel","",
	UDim2.new(0.9,0,0,28), UDim2.new(0.05,0,0,158), C.dim, 14)

-- Vote frame (spectators only)
local voteFrame = mkFrame(bFrame,"VoteFrame", UDim2.new(1,-20,0,108), UDim2.new(0,10,0,196), Color3.new(0,0,0), 1)
voteFrame.Visible = false
mkLabel(voteFrame,"VoteLbl","VOTE FOR THE BEST LOOK:", UDim2.new(1,0,0,22), UDim2.new(0,0,0,0), C.dim, 13)
local challengerVoteBtn = mkBtn(voteFrame,"ChallengerBtn","Vote: Challenger",
	UDim2.new(0.46,0,0,54), UDim2.new(0.01,0,0,24), Color3.fromRGB(50,0,80))
corner(challengerVoteBtn,6); challengerVoteBtn.TextColor3 = C.purple
local opponentVoteBtn = mkBtn(voteFrame,"OpponentBtn","Vote: Opponent",
	UDim2.new(0.46,0,0,54), UDim2.new(0.53,0,0,24), Color3.fromRGB(0,30,60))
corner(opponentVoteBtn,6); opponentVoteBtn.TextColor3 = C.cyan

-- Emote frame (battle participants)
local emoteFrame = mkFrame(bFrame,"EmoteFrame", UDim2.new(1,-20,0,108), UDim2.new(0,10,0,196), Color3.new(0,0,0), 1)
emoteFrame.Visible = false
mkLabel(emoteFrame,"EmoteLbl","USE EMOTES TO WIN THE CROWD!", UDim2.new(1,0,0,22), UDim2.new(0,0,0,0), C.pink, 13)

local EMOTES = {"Dance","Pose","Flex","Cute","Crown","Zap"}
local emoteBtns = {}
for i, em in ipairs(EMOTES) do
	local col = (i-1) % 3
	local row = math.floor((i-1) / 3)
	local eb = mkBtn(emoteFrame,"Emote"..i, em,
		UDim2.new(0.31,0,0,34), UDim2.new(0.01+col*0.33,0,0,25+row*37),
		Color3.fromRGB(30,20,50))
	eb.TextSize = 13; corner(eb,4)
	emoteBtns[i] = eb
end

-- Close button
local closeBattleBtn = mkBtn(bFrame,"CloseBtn","X",
	UDim2.new(0,32,0,32), UDim2.new(1,-36,0,4), Color3.fromRGB(60,20,20))
corner(closeBattleBtn,6)

-- ════════════════════════════════ ELEVATOR UI ════════════════════

local elevUI = playerGui:WaitForChild("ElevatorUI")

local eFrame = mkFrame(elevUI,"ElevFrame",
	UDim2.new(0,290,0,330), UDim2.new(1,-308,0.5,-165), C.bgDark, 0)
eFrame.Visible = false
corner(eFrame,12); stroke(eFrame, C.cyan)

local eTitleBar = mkFrame(eFrame,"ETitleBar", UDim2.new(1,0,0,50), UDim2.new(0,0,0,0), Color3.fromRGB(0,25,40), 0)
corner(eTitleBar,12)
mkLabel(eTitleBar,"ETitleLbl","ELEVATOR", UDim2.new(1,0,1,0), UDim2.new(0,0,0,0), C.cyan, 24)
mkLabel(eFrame,"ESubLbl","Select destination:",
	UDim2.new(0.9,0,0,24), UDim2.new(0.05,0,0,56), C.dim, 14)

local FLOOR_COLORS = {C.pink, Color3.fromRGB(0,100,255), C.gold}
local FLOOR_LABELS = {"1 - Main Club","2 - VIP Zone","3 - Celebrity Floor"}
local floorBtns    = {}
for i = 1, 3 do
	local fb = mkBtn(eFrame,"FloorBtn_"..i, "Floor "..FLOOR_LABELS[i],
		UDim2.new(0.85,0,0,58), UDim2.new(0.075,0,0,88+(i-1)*70), FLOOR_COLORS[i])
	fb.TextSize = 15; corner(fb)
	local lockLbl = mkLabel(fb,"Lock", i>1 and "LOCKED" or "",
		UDim2.new(0,60,1,0), UDim2.new(1,-64,0,0), C.white, 12)
	lockLbl.TextXAlignment = Enum.TextXAlignment.Center
	floorBtns[i] = fb
end
local closeElevBtn = mkBtn(eFrame,"CloseBtn","Close",
	UDim2.new(0.4,0,0,36), UDim2.new(0.3,0,1,-46), Color3.fromRGB(40,20,40))
corner(closeElevBtn,6)

-- ═══════════════════════════════════ OUTFIT UI ═══════════════════

local outfitPanel = mkFrame(mainHUD,"OutfitPanel",
	UDim2.new(0,320,0,430), UDim2.new(0,10,0.5,-215), C.bgDark, 0)
outfitPanel.Visible = false
corner(outfitPanel,12); stroke(outfitPanel, C.purple)

local oTitleBar = mkFrame(outfitPanel,"OTitleBar", UDim2.new(1,0,0,46), UDim2.new(0,0,0,0), Color3.fromRGB(25,0,40), 0)
corner(oTitleBar,12)
mkLabel(oTitleBar,"OTitleLbl","NEON WARDROBE", UDim2.new(1,0,1,0), UDim2.new(0,0,0,0), C.purple, 20)
mkLabel(outfitPanel,"OSubLbl","Choose your MOOD style:",
	UDim2.new(0.9,0,0,22), UDim2.new(0.05,0,0,52), C.dim, 13)

local MOOD_BG = {
	Angry      = Color3.fromRGB(80, 15, 15),
	Happy      = Color3.fromRGB(75, 65,  0),
	Mysterious = Color3.fromRGB(45,  0, 75),
	Cool       = Color3.fromRGB( 0, 45, 75),
	Cute       = Color3.fromRGB(70, 25, 55),
	Fierce     = Color3.fromRGB(75, 35,  0),
}
local moodBtns = {}
for i, mood in ipairs(GameConfig.MOODS) do
	local col = (i-1) % 2
	local row = math.floor((i-1) / 2)
	local mb = mkBtn(outfitPanel,"Mood_"..mood, mood,
		UDim2.new(0.44,0,0,46), UDim2.new(0.04+col*0.52,0,0,80+row*54),
		MOOD_BG[mood] or C.bgDark)
	mb.TextSize = 15; corner(mb,6)
	stroke(mb, GameConfig.MOOD_COLORS[mood] or C.white, 1)
	moodBtns[mood] = mb
end

local moodInfoLbl = mkLabel(outfitPanel,"MoodInfo","Current mood: Cool",
	UDim2.new(0.9,0,0,28), UDim2.new(0.05,0,0,315), C.pink, 15)
local closeOutfitBtn = mkBtn(outfitPanel,"CloseBtn","Close",
	UDim2.new(0.4,0,0,36), UDim2.new(0.3,0,1,-46), Color3.fromRGB(40,20,40))
corner(closeOutfitBtn,6)

-- ═══════════════════════════════════════════ STATE ══════════════

local currentBattle   = nil
local battleTimerConn = nil
local currentMood     = "Cool"
local unlockedFloors  = 1       -- highest floor the player has access to
local elevOpen        = false

-- ═══════════════════════════════════ HELPERS ════════════════════

local function notify(msg, col, dur)
	notifLabel.Text       = msg
	notifLabel.TextColor3 = col or C.gold
	task.delay(dur or 4, function()
		if notifLabel.Text == msg then notifLabel.Text = "" end
	end)
end

local function refreshElevatorUI()
	for i = 1, 3 do
		local fb = floorBtns[i]
		if fb then
			local lock = fb:FindFirstChild("Lock")
			if lock then
				lock.Text = (i <= unlockedFloors) and "" or "LOCKED"
			end
			fb.BackgroundTransparency = (i <= unlockedFloors) and 0 or 0.45
		end
	end
end

-- ═════════════════════════════════ BATTLE LOGIC ════════════════

local function startCountdown(duration)
	if battleTimerConn then battleTimerConn:Disconnect() end
	local t0 = tick()
	battleTimerConn = RunService.Heartbeat:Connect(function()
		local rem = math.max(0, duration - (tick() - t0))
		timerLabel.Text = tostring(math.ceil(rem))
		if rem <= 5 then
			timerLabel.TextColor3 = C.red
		elseif rem <= 10 then
			timerLabel.TextColor3 = C.orange
		else
			timerLabel.TextColor3 = C.cyan
		end
		if rem <= 0 then
			battleTimerConn:Disconnect()
			battleTimerConn = nil
		end
	end)
end

local function showBattle(data)
	bFrame.Visible = true
	themeLabel.Text = "Theme: " .. (data.theme or "?")
	startCountdown(data.duration or GameConfig.BATTLE_DURATION)

	if data.role == "spectator" then
		statusLabel.Text    = "Watching: " .. (data.challengerName or "?") .. " vs " .. (data.opponentName or "?")
		voteFrame.Visible   = true
		emoteFrame.Visible  = false
		challengerVoteBtn.Text = "Vote: " .. (data.challengerName or "Challenger")
		opponentVoteBtn.Text   = "Vote: " .. (data.opponentName   or "Opponent")
		challengerVoteBtn.BackgroundColor3 = Color3.fromRGB(50,0,80)
		opponentVoteBtn.BackgroundColor3   = Color3.fromRGB(0,30,60)
	else
		statusLabel.Text   = "YOU ARE " .. string.upper(data.role or "BATTLING") .. "!"
		voteFrame.Visible  = false
		emoteFrame.Visible = true
	end
end

local function hideBattle(result)
	if battleTimerConn then
		battleTimerConn:Disconnect()
		battleTimerConn = nil
	end
	currentBattle = nil

	if result then
		if result.result == "win" then
			notify("YOU WIN! +" .. (result.reputationGained or 0)
				.. " Rep | +" .. (result.currencyGained or 0) .. " Coins!", C.green, 6)
		else
			notify("Better luck next time! +" .. (result.reputationGained or 0) .. " Rep", C.orange, 4)
		end
	end

	local tw = TweenService:Create(bFrame, TweenInfo.new(0.4), {BackgroundTransparency=1})
	tw:Play()
	tw.Completed:Connect(function()
		bFrame.Visible              = false
		bFrame.BackgroundTransparency = 0
	end)
end

-- Remote: battle start
startBattleEv.OnClientEvent:Connect(function(data)
	if not data then return end
	if data.error then
		notify(data.error, C.red)
		return
	end
	if data.announcement then
		notify(data.announcement, C.gold, 8)
		return
	end
	currentBattle = data
	showBattle(data)
	if data.role ~= "spectator" then
		notify("BATTLE! Theme: " .. (data.theme or ""), C.pink, 3)
	end
end)

-- Remote: battle result
battleResultEv.OnClientEvent:Connect(function(result)
	hideBattle(result)
end)

-- Vote buttons (spectator)
challengerVoteBtn.MouseButton1Click:Connect(function()
	if currentBattle and currentBattle.role == "spectator" then
		startBattleEv:FireServer("vote",{battleId=currentBattle.battleId, votedFor="challenger"})
		challengerVoteBtn.BackgroundColor3 = C.green
		notify("Voted for " .. (currentBattle.challengerName or "Challenger") .. "!", C.green, 2)
	end
end)
opponentVoteBtn.MouseButton1Click:Connect(function()
	if currentBattle and currentBattle.role == "spectator" then
		startBattleEv:FireServer("vote",{battleId=currentBattle.battleId, votedFor="opponent"})
		opponentVoteBtn.BackgroundColor3 = C.green
		notify("Voted for " .. (currentBattle.opponentName or "Opponent") .. "!", C.green, 2)
	end
end)

-- Emote buttons (battler) — purely cosmetic; they animate the button and
-- show a notification but do NOT send votes (only spectators may vote).
for i, eb in ipairs(emoteBtns) do
	eb.MouseButton1Click:Connect(function()
		if currentBattle and currentBattle.role ~= "spectator" then
			local orig = eb.BackgroundColor3
			eb.BackgroundColor3 = C.pink
			task.delay(0.15, function() eb.BackgroundColor3 = orig end)
			notify("Emote " .. EMOTES[i] .. "! Crowd impressed.", C.pink, 1)
		end
	end)
end

closeBattleBtn.MouseButton1Click:Connect(function() hideBattle(nil) end)

-- Challenge button
challengeBtn.MouseButton1Click:Connect(function()
	local myChar = player.Character
	if not myChar then return end
	local myHRP = myChar:FindFirstChild("HumanoidRootPart")
	if not myHRP then return end

	local nearest, nearestDist = nil, GameConfig.BATTLE_CHALLENGE_RANGE
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and other.Character then
			local h = other.Character:FindFirstChild("HumanoidRootPart")
			if h then
				local d = (myHRP.Position - h.Position).Magnitude
				if d < nearestDist then
					nearestDist = d; nearest = other
				end
			end
		end
	end

	if nearest then
		startBattleEv:FireServer("challenge", {targetName = nearest.Name})
		notify("Challenging " .. nearest.Name .. "!", C.pink, 2)
	else
		notify("Walk up to a player to challenge them!", C.orange, 3)
	end
end)

-- ═══════════════════════════════════ ELEVATOR ═══════════════════

elevatorBtn.MouseButton1Click:Connect(function()
	elevOpen       = not elevOpen
	eFrame.Visible = elevOpen
end)

closeElevBtn.MouseButton1Click:Connect(function()
	eFrame.Visible = false; elevOpen = false
end)

for i = 1, 3 do
	floorBtns[i].MouseButton1Click:Connect(function()
		requestElevEv:FireServer(i)
		eFrame.Visible = false; elevOpen = false
		notify("Traveling to Floor " .. i .. "...", C.cyan, 3)
	end)
end

-- Server tells client to open the elevator panel (ProximityPrompt trigger)
requestElevEv.OnClientEvent:Connect(function(msg)
	if msg == "open" then
		eFrame.Visible = true; elevOpen = true
	end
end)

-- ══════════════════════════════ OUTFIT / MOOD ════════════════════

local function applyMoodEffect(mood)
	local char = player.Character
	if char then
		local moodColor = GameConfig.MOOD_COLORS[mood] or C.white
		for _, desc in ipairs(char:GetDescendants()) do
			if desc:IsA("BasePart") and desc.Name ~= "HumanoidRootPart" then
				local hl = desc:FindFirstChild("NeonGlow")
				if not hl then
					hl = Instance.new("SelectionBox")
					hl.Name               = "NeonGlow"
					hl.Adornee            = desc
					hl.LineThickness      = 0.04
					hl.SurfaceTransparency= 0.9
					hl.Parent             = desc
				end
				hl.Color3        = moodColor
				hl.SurfaceColor3 = moodColor
			end
		end
	end
	moodLabel.Text  = "Mood: " .. mood
	moodInfoLbl.Text= "Current mood: " .. mood
	updateMoodEv:FireServer(mood)
end

local function selectMood(mood)
	currentMood = mood
	for m, mb in pairs(moodBtns) do
		mb.BackgroundTransparency = (m == mood) and 0 or 0.3
	end
	applyMoodEffect(mood)
	notify("Mood set to: " .. mood, GameConfig.MOOD_COLORS[mood], 3)
end

for mood, mb in pairs(moodBtns) do
	mb.MouseButton1Click:Connect(function() selectMood(mood) end)
end

outfitBtn.MouseButton1Click:Connect(function()
	outfitPanel.Visible = not outfitPanel.Visible
end)
closeOutfitBtn.MouseButton1Click:Connect(function()
	outfitPanel.Visible = false
end)

-- ════════════════════════════ SERVER REMOTE UPDATES ══════════════

updateCoinEv.OnClientEvent:Connect(function(amount)
	currencyLabel.Text = tostring(amount) .. " Coins"
end)

unlockFloorEv.OnClientEvent:Connect(function(data)
	if type(data) == "table" then
		if data.floorUnlocked then
			unlockedFloors = math.max(unlockedFloors, data.floorUnlocked)
			refreshElevatorUI()
			floorLabel.Text = "Floor " .. data.floorUnlocked .. " - " .. (data.floorName or "")
			notify("FLOOR " .. data.floorUnlocked .. " UNLOCKED! (" .. (data.floorName or "") .. ")", C.green, 8)
		elseif data.error then
			notify(data.error, C.red, 5)
		end
	end
end)

-- Keep Rep label in sync via leaderstats
task.spawn(function()
	local ls = player:WaitForChild("leaderstats", 15)
	if not ls then return end
	local repVal   = ls:WaitForChild("Reputation", 5)
	local floorVal = ls:WaitForChild("Floor",      5)

	if repVal then
		repVal.Changed:Connect(function(v)
			repLabel.Text = "Rep: " .. tostring(v)
		end)
		repLabel.Text = "Rep: " .. tostring(repVal.Value)
	end

	if floorVal then
		floorVal.Changed:Connect(function(v)
			floorLabel.Text = "Floor " .. v .. " - " .. (GameConfig.FLOOR_NAMES[v] or "")
		end)
	end
end)

-- Apply mood glow when character loads
player.CharacterAdded:Connect(function()
	task.wait(1)
	applyMoodEffect(currentMood)
end)
if player.Character then
	task.delay(1, function() applyMoodEffect(currentMood) end)
end

-- Initial elevator UI state
refreshElevatorUI()

print("[MainClient] NEON WARDROBE client ready!")
]]></ProtectedString>
				</Properties>
			</Item><!-- /MainClient -->
		</Item><!-- /StarterPlayerScripts -->
	</Item><!-- /StarterPlayer -->

